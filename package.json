{
  "name": "shiba-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone small desktop companion",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/core.cjs && node --check src/renderer.js",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0"
  },
  "build": {
    "appId": "local.shiba.desktop",
    "productName": "Shiba Desktop",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    },
    "compression": "store"
  }
}
