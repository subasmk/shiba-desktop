{
  "name": "shiba-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone small desktop companion",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test core.test.cjs",
    "check": "node --check main.cjs && node --check preload.cjs && node --check core.cjs && node --check renderer.js",
    "build:win": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "local.shiba.desktop",
    "productName": "Shiba Desktop",
    "files": [
      "*.cjs",
      "*.html",
      "*.css",
      "*.js",
      "*.json",
      "*.png"
    ],
    "win": {
      "target": "portable"
    },
    "directories": {
      "output": "dist"
    },
    "compression": "store"
  }
}
